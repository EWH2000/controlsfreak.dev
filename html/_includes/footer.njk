<footer>
    <span class="footer-left">
        <span class="ok-pill">OK</span>
        <span class="footer-text">{{ "footer.tagline" | t(locale) }}</span>
        <a class="footer-text" href="{{ "/privacy.html" | localePath(locale) }}">{{ "footer.privacy" | t(locale) }}</a>
    </span>
    <span class="footer-right">
        <span class="footer-text">v<strong>{{ site.version }}</strong> · {{ "footer.built" | t(locale) }} <time datetime="{{ site.buildDate }}">{{ site.buildYear }}</time></span>
        <span class="heartbeat-dot" aria-hidden="true"></span>
    </span>
</footer>
