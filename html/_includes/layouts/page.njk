<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
    {% block head %}{% endblock %}
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>

{% include "schematic-bg.njk" %}

{% include "nav.njk" %}

{% block content %}{% endblock %}

{% include "footer.njk" %}
{# flow-engine.js is loaded site-wide because the gutter schematic
   motifs (schematic-bg.njk) opt in via data-flow / data-pulse on
   every page. Pages with their own diagrams stop including it
   themselves — a duplicate <script src> would start a second rAF
   loop with its own state. schematic-bg.js calls FlowEngine.init()
   once on DOMContentLoaded; page-level FlowEngine.init() calls
   stay (idempotent — second call refreshes pools, doesn't restart
   the loop). #}
<script src="/scripts/flow-engine.js"></script>
<script src="/scripts/schematic-bg.js"></script>
{# fullscreen-toggle.js is loaded site-wide so any future tool can opt
   into fullscreen with a single button. Pages without a
   [data-fullscreen-target] button cost nothing. Loaded before
   {% block scripts %} so its keydown listener registers before any
   page-level keydown handler. #}
<script src="/scripts/fullscreen-toggle.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
