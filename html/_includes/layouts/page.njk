<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
    {% block head %}{% endblock %}
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>

{% include "schematic-bg.njk" %}

{% include "nav.njk" %}

{% block content %}{% endblock %}

{% include "footer.njk" %}

{# Site search palette — static markup so search.js only reveals/populates
   it (no build-a-DOM flash). role="dialog" + aria-modal; the input is an
   ARIA combobox driving the listbox of results. Lives at end-of-body so
   it's outside the sticky nav's stacking context. See scripts/search.js. #}
<div id="palette" class="palette" role="dialog" aria-modal="true" aria-label="Search the site" hidden>
    <div class="palette-box">
        <div class="palette-field">
            <svg class="palette-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="7" cy="7" r="4.5"/><line x1="10.6" y1="10.6" x2="14" y2="14"/>
            </svg>
            {# type="text", not "search": ARIA-in-HTML forbids a role
               override on input[type=search] (audit-2026-06 #56).
               inputmode/enterkeyhint keep the mobile search keyboard.
               aria-activedescendant is set/removed by search.js — an
               empty-string value is invalid ARIA. #}
            <input id="palette-input" class="palette-input" type="text" role="combobox"
                   inputmode="search" enterkeyhint="search"
                   aria-expanded="false" aria-controls="palette-results"
                   aria-autocomplete="list" autocomplete="off" autocapitalize="off"
                   spellcheck="false" placeholder="Search tools, simulators, lessons…"
                   aria-label="Search the site">
            <kbd class="palette-hint">esc</kbd>
        </div>
        <ul id="palette-results" class="palette-results" role="listbox" aria-label="Search results"></ul>
        <p id="palette-status" class="palette-status" role="status" aria-live="polite" hidden></p>
    </div>
</div>

{# flow-engine.js is loaded site-wide because the gutter schematic
   motifs (schematic-bg.njk) opt in via data-flow / data-pulse on
   every page. Pages with their own diagrams stop including it
   themselves — a duplicate <script src> would start a second rAF
   loop with its own state. schematic-bg.js calls FlowEngine.init()
   once on DOMContentLoaded; page-level FlowEngine.init() calls
   stay (idempotent — second call refreshes pools, doesn't restart
   the loop). #}
{# theme.js and units.js are loaded site-wide so BOTH nav toggle pills
   work on every page. theme.js wires the .theme-btn pill, syncs
   aria-pressed + the theme-color meta, and persists cf_theme (the
   before-paint bootstrap in head.njk already set [data-theme]; the
   script owns the runtime). units.js wires the .units-btn pill the
   same way (persists cf_units) and its DOM walker no-ops on pages
   without data-us/data-metric spans. Before units.js went site-wide
   the units pill was rendered but dead on every non-converting page —
   clicks did nothing, the choice didn't persist, and the hard-coded
   aria-pressed never re-synced (audit-2026-06 #2). Pages must NOT
   load units.js themselves anymore — a duplicate <script src> would
   re-run the IIFE and double-wire the toggle listeners. #}
<script src="/scripts/theme.js?v={{ site.version }}"></script>
<script src="/scripts/units.js?v={{ site.version }}"></script>
{# search.js is loaded site-wide so the command palette (/ or Ctrl/⌘-K, or
   the .nav-search-btn) works on every page. It reveals the #palette dialog
   above and fetches /search-index.json on first open. #}
<script src="/scripts/search.js?v={{ site.version }}"></script>
{# nav-menu.js is loaded site-wide so the Tools/Simulators/Education
   dropdowns work on every page (disclosure buttons, keyboard + touch). #}
<script src="/scripts/nav-menu.js?v={{ site.version }}"></script>
<script src="/scripts/flow-engine.js?v={{ site.version }}"></script>
<script src="/scripts/schematic-bg.js?v={{ site.version }}"></script>
{# fullscreen-toggle.js is loaded site-wide so any future tool can opt
   into fullscreen with a single button. Pages without a
   [data-fullscreen-target] button cost nothing. Loaded before
   {% block scripts %} so its keydown listener registers before any
   page-level keydown handler. #}
<script src="/scripts/fullscreen-toggle.js?v={{ site.version }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
