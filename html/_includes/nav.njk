{% from "nav-dropdown.njk" import navDropdown %}
<nav class="site-nav">
    <a class="site-nav-brand" href="/">controlsfreak<span>.dev</span></a>
    <div class="site-nav-links" id="site-nav-links">
        <a href="/"{% if nav == "home" %} class="active"{% endif %}>Home</a>
        <a class="nav-start-here" href="/education/" aria-label="New to controls? Start here — the Education lessons">Start here →</a>
        {{ navDropdown('tools', 'Tools', '/tools/', nav == 'tools', collections.navTools | navGroups('tools'), null, 'Calculators and converters for the day-to-day.') }}
        {{ navDropdown('simulators', 'Simulators', '/simulators/', nav == 'simulators', null, collections.navSimulators, 'Interactive models to poke at before the real thing.') }}
        {{ navDropdown('education', 'Education', '/education/', nav == 'education', collections.navEducation | navGroups('education'), null, 'Plain-English lessons, from the ground up.') }}
        {{ navDropdown('practice', 'Practice', '/practice/', nav == 'practice', collections.navPractice | navGroups('practice'), null, 'Quick quizzes and field drills to test yourself.') }}
        <a href="/contact.html"{% if nav == "contact" %} class="active"{% endif %}>Contact</a>
        <button type="button" class="nav-search-btn" id="nav-search-btn" aria-haspopup="dialog" aria-label="Search (press slash)">
            <svg class="nav-search-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="7" cy="7" r="4.5"/><line x1="10.6" y1="10.6" x2="14" y2="14"/>
            </svg>
            <span class="nav-search-label">Search</span>
            <kbd class="nav-search-kbd">/</kbd>
        </button>
        <span class="units-toggle">
            <span class="units-label">Units:</span>
            <span class="units-toggle-pill">
                <button class="units-btn" data-units="us" aria-pressed="true">US</button>
                <button class="units-btn" data-units="metric" aria-pressed="false">Metric</button>
            </span>
        </span>
        <span class="theme-toggle">
            <span class="theme-label">Theme:</span>
            <span class="theme-toggle-pill">
                <button class="theme-btn" data-theme-set="dark" aria-pressed="true">Dark</button>
                <button class="theme-btn" data-theme-set="light" aria-pressed="false">Light</button>
            </span>
        </span>
    </div>
    <button type="button" class="nav-search-btn nav-search-btn--mobile" aria-haspopup="dialog" aria-label="Search">
        <svg class="nav-search-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="7" cy="7" r="4.5"/><line x1="10.6" y1="10.6" x2="14" y2="14"/>
        </svg>
    </button>
    <button type="button" class="nav-hamburger" id="nav-hamburger" aria-expanded="false" aria-controls="site-nav-links" aria-label="Open menu">
        <svg class="nav-burger-icon" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <line x1="2" y1="5" x2="16" y2="5"/><line x1="2" y1="9" x2="16" y2="9"/><line x1="2" y1="13" x2="16" y2="13"/>
        </svg>
        <svg class="nav-close-icon" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <line x1="4" y1="4" x2="14" y2="14"/><line x1="14" y1="4" x2="4" y2="14"/>
        </svg>
    </button>
</nav>
