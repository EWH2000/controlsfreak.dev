<nav class="site-nav">
    <a class="site-nav-brand" href="/">controlsfreak<span>.dev</span></a>
    <div class="site-nav-links">
        <a href="/"{% if nav == "home" %} class="active"{% endif %}>Home</a>
        <span class="nav-item nav-item--has-menu">
            <a href="/tools/"{% if nav == "tools" %} class="active"{% endif %}>Tools</a>
            <button type="button" class="nav-menu-toggle" id="nav-tools-toggle" aria-expanded="false" aria-controls="nav-tools-menu" aria-label="Toggle Tools menu">
                <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l4 4 4-4"/></svg>
            </button>
            <div class="nav-menu" id="nav-tools-menu" aria-label="Tools" hidden>
                {% for p in collections.navTools %}
                <a class="nav-menu-item" href="{{ p.data.canonical | canonicalPath }}">{{ p.data.title | cleanTitle }}</a>
                {% endfor %}
            </div>
        </span>
        <span class="nav-item nav-item--has-menu">
            <a href="/simulators/"{% if nav == "simulators" %} class="active"{% endif %}>Simulators</a>
            <button type="button" class="nav-menu-toggle" id="nav-simulators-toggle" aria-expanded="false" aria-controls="nav-simulators-menu" aria-label="Toggle Simulators menu">
                <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l4 4 4-4"/></svg>
            </button>
            <div class="nav-menu" id="nav-simulators-menu" aria-label="Simulators" hidden>
                {% for p in collections.navSimulators %}
                <a class="nav-menu-item" href="{{ p.data.canonical | canonicalPath }}">{{ p.data.title | cleanTitle }}</a>
                {% endfor %}
            </div>
        </span>
        <span class="nav-item nav-item--has-menu">
            <a href="/education/"{% if nav == "education" %} class="active"{% endif %}>Education</a>
            <button type="button" class="nav-menu-toggle" id="nav-education-toggle" aria-expanded="false" aria-controls="nav-education-menu" aria-label="Toggle Education menu">
                <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l4 4 4-4"/></svg>
            </button>
            <div class="nav-menu" id="nav-education-menu" aria-label="Education" hidden>
                {% for p in collections.navEducation %}
                <a class="nav-menu-item" href="{{ p.data.canonical | canonicalPath }}">{{ p.data.title | cleanTitle }}</a>
                {% endfor %}
            </div>
        </span>
        <a href="/practice/"{% if nav == "practice" %} class="active"{% endif %}>Practice</a>
        <a href="/contact.html"{% if nav == "contact" %} class="active"{% endif %}>Contact</a>
        <button type="button" class="nav-search-btn" id="nav-search-btn" aria-haspopup="dialog" aria-label="Search (press slash)">
            <svg class="nav-search-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="7" cy="7" r="4.5"/><line x1="10.6" y1="10.6" x2="14" y2="14"/>
            </svg>
            <span class="nav-search-label">Search</span>
            <kbd class="nav-search-kbd">/</kbd>
        </button>
        <span class="units-toggle">
            <span class="units-label">Units:</span>
            <span class="units-toggle-pill">
                <button class="units-btn" data-units="us" aria-pressed="true">US</button>
                <button class="units-btn" data-units="metric" aria-pressed="false">Metric</button>
            </span>
        </span>
        <span class="theme-toggle">
            <span class="theme-label">Theme:</span>
            <span class="theme-toggle-pill">
                <button class="theme-btn" data-theme-set="dark" aria-pressed="true">Dark</button>
                <button class="theme-btn" data-theme-set="light" aria-pressed="false">Light</button>
            </span>
        </span>
    </div>
</nav>
