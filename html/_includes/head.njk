    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#ffffff">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% endif %}
    {% if canonical %}
    <link rel="canonical" href="{{ canonical }}">
    {% endif %}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    {% if canonical %}
    <meta property="og:url" content="{{ canonical }}">
    {% endif %}
    <meta property="og:image" content="https://controlsfreak.dev/assets/og-image.png">
    <meta property="og:site_name" content="controlsfreak.dev">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://controlsfreak.dev/assets/og-image.png">
    {% set breadcrumbJson = canonical | breadcrumbJsonLd(nav, title) %}
    {% if breadcrumbJson %}
    <script type="application/ld+json">{{ breadcrumbJson | safe }}</script>
    {% endif %}
    {% if nav == "education" %}
    <script type="application/ld+json">{{ canonical | techArticleJsonLd(title, description, page.inputPath | gitFirstmod, page.inputPath | gitLastmod) | safe }}</script>
    {% set eduRels = educationSequence[page.url] %}
    {% if eduRels.prev %}<link rel="prev" href="{{ eduRels.prev }}">{% endif %}
    {% if eduRels.next %}<link rel="next" href="{{ eduRels.next }}">{% endif %}
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon-180.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Overpass:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script>(function(){try{var u=localStorage.getItem('cf_units');document.documentElement.dataset.units=u==='metric'?'metric':'us';}catch(e){}})();</script>
