    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="theme-color" content="#13161b">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% endif %}
    {% set canonicalUrl = canonical | cleanCanonical %}
    {% if canonical %}
    <link rel="canonical" href="{{ canonicalUrl }}">
    {% endif %}
    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    {% if canonical %}
    <meta property="og:url" content="{{ canonicalUrl }}">
    {% endif %}
    <meta property="og:image" content="https://controlsfreak.dev/assets/og-image.png">
    <meta property="og:site_name" content="controlsfreak.dev">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="https://controlsfreak.dev/assets/og-image.png">
    {% set breadcrumbJson = canonicalUrl | breadcrumbJsonLd(nav, title) %}
    {% if breadcrumbJson %}
    <script type="application/ld+json">{{ breadcrumbJson | safe }}</script>
    {% endif %}
    {% if nav == "education" and page.url != "/education/" %}
    <script type="application/ld+json">{{ canonicalUrl | techArticleJsonLd(title, description, page.inputPath | gitFirstmod, page.inputPath | gitLastmod, pairedQuiz | cleanCanonical) | safe }}</script>
    {% set eduRels = educationSequence[page.url] %}
    {% if eduRels.prev %}<link rel="prev" href="{{ eduRels.prev }}">{% endif %}
    {% if eduRels.next %}<link rel="next" href="{{ eduRels.next }}">{% endif %}
    {% endif %}
    {% if nav == "practice" and quizzes[page.fileSlug] %}
    <script type="application/ld+json">{{ canonicalUrl | faqPageJsonLd(quizzes[page.fileSlug], title, pairedLesson | cleanCanonical) | safe }}</script>
    {% endif %}
    {% if faqs %}
    <script type="application/ld+json">{{ canonicalUrl | faqJsonLd(faqs, title) | safe }}</script>
    {% endif %}
    {% if termSets %}
    {%- for ts in termSets %}
    <script type="application/ld+json">{{ canonicalUrl | definedTermSetJsonLd(bacnetEnums[ts.key], ts.name, ts.fragment, ts.description) | safe }}</script>
    {%- endfor %}
    {% endif %}
    {% if canonicalUrl and ((nav == "tools" and page.url != "/tools/") or (nav == "simulators" and page.url != "/simulators/")) %}
    <script type="application/ld+json">{{ canonicalUrl | softwareApplicationJsonLd(title, description) | safe }}</script>
    {% endif %}
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon-180.png">
    {# Fonts are self-hosted (audit-2026-06 #33) — @font-face lives at
       the top of styles.css, files under /assets/fonts/. No third-party
       origin: Turnstile on contact.html is now the site's only one. #}
    <link rel="stylesheet" href="/styles.css?v={{ site.version }}">
    <script>(function(){try{var u=localStorage.getItem('cf_units');document.documentElement.dataset.units=u==='metric'?'metric':'us';}catch(e){}})();</script>
    <script>(function(){try{var t=localStorage.getItem('cf_theme');if(t!=='light'&&t!=='dark'){t=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches)?'light':'dark';}document.documentElement.dataset.theme=t;var m=document.querySelector('meta[name="theme-color"]');if(m)m.content=t==='light'?'#ffffff':'#13161b';}catch(e){}})();</script>
