{# ─────────────────────────────────────────────────────────────────
    SCHEMATIC BACKGROUND — gutter as-builts.

    Two narrow vertical strips, one in each gutter, holding inline-
    SVG motifs (piping, control wiring, function blocks, BACnet
    nodes). Strips sit at z-index:-1 inside body's stacking context
    (above the blueprint grid, below every content surface).

    Each motif is inlined directly into its <svg class="sbg-motif">
    wrapper — no <symbol>/<use>. flow-engine.js reads path geometry
    via getTotalLength() / getPointAtLength(), and that doesn't pierce
    <use> shadow trees in Chromium (same root cause that bit us with
    `fill:none` on the first pass). The trade-off is repeated markup
    across motifs — kept manageable by the {% macro motifBody %}
    below, which expands by id.

    Path tagging conventions:
        data-flow="supply"|"return"   continuous particle flow
                                      (hydronic pipes; flow-engine.js
                                      handles the rest)
        data-pulse="signal"           EBO-style discrete pulse on the
                                      wire (analog/binary control
                                      wiring, function-block signal
                                      lines, BACnet/IP comm traces)
        data-pulse-color="<var()>"    pulse fill; default = the path's
                                      stroke attr
        data-pulse-interval="<ms>"    auto-fire cadence (default 4000)
        data-sbg-stroke               carries the scroll-reveal
                                      stroke-dashoffset transition
                                      (CSS rule in styles.css uses a
                                      fixed dasharray well above any
                                      path length — see the block
                                      comment there for why all
                                      length-normalization approaches
                                      hit Chromium quirks).

    Hidden below 1240px viewport (no real gutter to fill) and on
    print. Decorative only: aria-hidden, pointer-events:none.
#}

{% macro motifBody(id) -%}
{%- if id == 'pipe-valve' -%}
{# 3-way diverting valve serving a coil with a bypass loop back to return.
   Supply main runs L→R across the top; return main runs R→L across the
   bottom (reversed x1/x2 makes flow-engine walk return particles
   right-to-left, so the two mains read as opposing conveyors).
   Bypass-to-tee and coil-to-tee are split at the tee at (120,92) per the
   "converging-flow segments need two paths" rule — bypass arrives R→L
   still tagged supply (hasn't been through the coil), coil-out arrives
   L→R tagged return. Mirrors the convention on education/load-piping.html. #}
<line x1="4"   y1="18"  x2="196" y2="18"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="80"  y1="18"  x2="80"  y2="26"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<path d="M72 26 L88 26 L80 32 Z  M72 38 L88 38 L80 32 Z  M92 26 L92 38 L80 32 Z" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<line x1="80"  y1="38"  x2="80"  y2="42"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<rect x="60"   y="42"   width="40" height="24" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<path d="M66 48 L94 48 M66 54 L94 54 M66 60 L94 60" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<line x1="80"  y1="66"  x2="80"  y2="92"  stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="80"  y1="92"  x2="120" y2="92"  stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="92"  y1="32"  x2="170" y2="32"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="170" y1="32"  x2="170" y2="92"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="170" y1="92"  x2="120" y2="92"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="120" y1="92"  x2="120" y2="108" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="196" y1="108" x2="4"   y2="108" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<text x="14" y="14"  class="sbg-label">SUP</text>
<text x="14" y="124" class="sbg-label">RET</text>
{%- elif id == 'pump-coil' -%}
{# Closed-loop coil + pump: pump pushes supply (top pipe, walking R→L
   from pump out to coil) and pulls return (bottom pipe, walking L→R
   from coil back to pump). Opposing flows reinforce the loop concept
   — same reversed-coords trick as pipe-valve. Pipes terminate tangent
   to the pump circle at (158, 25) and (158, 65); the single-point
   connections read as "plumbed in" because of the matching y-extent
   of the coil rect (y=25-65) on the other side. #}
<rect x="14" y="25" width="56" height="40" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<path d="M22 32 L62 32 M22 40 L62 40 M22 48 L62 48 M22 56 L62 56" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<circle cx="158" cy="45" r="20" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<path d="M148 45 L168 45 M158 35 L158 55" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<line x1="158" y1="25" x2="70"  y2="25" stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="70"  y1="65" x2="158" y2="65" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<text x="14"  y="18" class="sbg-label">COIL</text>
<text x="158" y="82" text-anchor="middle" class="sbg-label">P-1</text>
{%- elif id == 'compare-bo' -%}
{# Small piece of real BAS logic: two analog inputs feed a greater-than
   comparator whose binary result drives a BO. Pattern shows up everywhere
   (high-limit cutoff, OAT-vs-setpoint enable, freezestat). AI sides are
   amber (analog signal), the comparator is plum (matches the logic-chain
   family), the BO side is gray (binary). Pulse intervals are staggered
   so the three wires don't fire in lockstep. #}
<rect x="10" y="10" width="38" height="24" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="22" r="2.5" fill="var(--amber)"/>
<circle cx="38" cy="22" r="2.5" fill="var(--amber)"/>
<text x="29" y="6" text-anchor="middle" class="sbg-label">AI1</text>
<rect x="10" y="66" width="38" height="24" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="78" r="2.5" fill="var(--amber)"/>
<circle cx="38" cy="78" r="2.5" fill="var(--amber)"/>
<text x="29" y="98" text-anchor="middle" class="sbg-label">AI2</text>
<rect x="86" y="39" width="28" height="22" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="55" text-anchor="middle" class="sbg-label">&gt;</text>
<rect x="152" y="39" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="162" cy="50" r="2.5" fill="var(--text-dim)"/>
<circle cx="180" cy="50" r="2.5" fill="var(--text-dim)"/>
<text x="171" y="35" text-anchor="middle" class="sbg-label">BO1</text>
<path d="M48 22 L66 22 L66 45 L86 45" stroke="var(--amber)" fill="none" data-pulse="signal" data-sbg-stroke/>
<path d="M48 78 L66 78 L66 55 L86 55" stroke="var(--amber)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
<path d="M114 50 L152 50" stroke="var(--text-dim)" fill="none" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
{%- elif id == 'and-bo' -%}
{# Sibling of compare-bo: two binary inputs through an AND gate to a BO.
   Pattern shows up everywhere in BAS — "all proofs made AND schedule
   occupied" before energizing a starter, two safety interlocks both
   need to be true, etc. Layout mirrors compare-bo exactly (same block
   geometry, wire routing, pulse staggering) so the two motifs read as
   a family; only difference is everything is gray (binary) and the
   logic block carries "AND" instead of ">". #}
<rect x="10" y="10" width="38" height="24" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="22" r="2.5" fill="var(--text-dim)"/>
<circle cx="38" cy="22" r="2.5" fill="var(--text-dim)"/>
<text x="29" y="6" text-anchor="middle" class="sbg-label">BI1</text>
<rect x="10" y="66" width="38" height="24" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="78" r="2.5" fill="var(--text-dim)"/>
<circle cx="38" cy="78" r="2.5" fill="var(--text-dim)"/>
<text x="29" y="98" text-anchor="middle" class="sbg-label">BI2</text>
<rect x="86" y="39" width="28" height="22" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="54" text-anchor="middle" class="sbg-label">AND</text>
<rect x="152" y="39" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="162" cy="50" r="2.5" fill="var(--text-dim)"/>
<circle cx="180" cy="50" r="2.5" fill="var(--text-dim)"/>
<text x="171" y="35" text-anchor="middle" class="sbg-label">BO1</text>
<path d="M48 22 L66 22 L66 45 L86 45" stroke="var(--text-dim)" fill="none" data-pulse="signal" data-sbg-stroke/>
<path d="M48 78 L66 78 L66 55 L86 55" stroke="var(--text-dim)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
<path d="M114 50 L152 50" stroke="var(--text-dim)" fill="none" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
{%- elif id == 'logic-chain' -%}
<rect x="14" y="14" width="56" height="28" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="42" y="33" text-anchor="middle" class="sbg-label">TMR</text>
<rect x="74" y="50" width="56" height="28" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="102" y="69" text-anchor="middle" class="sbg-label">AND</text>
<rect x="134" y="80" width="52" height="22" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="160" y="96" text-anchor="middle" class="sbg-label">PID</text>
<path d="M70 28 L82 28 L82 64 L74 64" stroke="var(--plum)" fill="none" data-pulse="signal" data-sbg-stroke/>
<path d="M130 64 L142 64 L142 91 L134 91" stroke="var(--plum)" fill="none" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
{%- elif id == 'bacnet-node' -%}
<rect x="14" y="34" width="76" height="26" stroke="var(--teal)" fill="var(--surface)" data-sbg-stroke/>
<text x="52" y="51" text-anchor="middle" class="sbg-label">BACnet/IP</text>
<path d="M90 42 L130 42 L160 22" stroke="var(--teal)" fill="none" data-pulse="signal" data-sbg-stroke/>
<circle cx="160" cy="22" r="3" fill="var(--teal)"/>
<text x="172" y="20" class="sbg-label">N2</text>
<path d="M90 52 L130 52 L160 72" stroke="var(--teal)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
<circle cx="160" cy="72" r="3" fill="var(--teal)"/>
<text x="172" y="76" class="sbg-label">N5</text>
{%- endif -%}
{%- endmacro %}

{#  Motifs are placed at uniform Y stride down each gutter, cycling
    through a short sequence so a long page never runs out of motifs.
    Stride = 270px so the tallest motif (pipe-valve at 130px
    rendered ~1.7× = ~221px at the strip's 340px cap) fits with
    breathing room above and below. Count = 60 covers ~16200px of
    page; pages shorter than that just clip the tail via
    overflow:hidden on the strip container.

    Two sequences are offset between left/right so a wide viewport
    doesn't show a mirrored pair. Heights table is shared because
    the macro renders motifs at their viewBox aspect — only the
    h value here matters (sets the SVG's viewBox height). #}

{% set sbgHeights = {
    'pipe-valve': 130,
    'pump-coil':  90,
    'compare-bo': 100,
    'and-bo':     100,
    'logic-chain': 110,
    'bacnet-node': 90
} %}
{% set sbgLeftCycle = [
    'pipe-valve', 'compare-bo', 'pump-coil', 'logic-chain', 'bacnet-node',
    'pipe-valve', 'and-bo',     'pump-coil', 'logic-chain', 'bacnet-node'
] %}
{% set sbgRightCycle = [
    'and-bo',     'logic-chain', 'pipe-valve', 'bacnet-node', 'pump-coil',
    'compare-bo', 'pipe-valve',  'logic-chain', 'bacnet-node', 'pump-coil'
] %}
{% set sbgCount  = 60 %}
{% set sbgStride = 270 %}

<div class="schematic-bg schematic-bg--left" aria-hidden="true">
    {%- for i in range(sbgCount) -%}
        {%- set mid = sbgLeftCycle[i % sbgLeftCycle.length] -%}
        {%- set y = 100 + i * sbgStride -%}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ sbgHeights[mid] }}" style="--sbg-y: {{ y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false">{{ motifBody(mid) | safe }}</svg>
    {% endfor %}
</div>

<div class="schematic-bg schematic-bg--right" aria-hidden="true">
    {%- for i in range(sbgCount) -%}
        {%- set mid = sbgRightCycle[i % sbgRightCycle.length] -%}
        {%- set y = 220 + i * sbgStride -%}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ sbgHeights[mid] }}" style="--sbg-y: {{ y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false">{{ motifBody(mid) | safe }}</svg>
    {% endfor %}
</div>
