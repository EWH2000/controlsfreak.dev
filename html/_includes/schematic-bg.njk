<div class="schematic-bg schematic-bg--left" aria-hidden="true">
    {% for m in sbgLeftMotifs %}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ m.h }}" style="--sbg-y: {{ m.y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false"><use href="#sbg-{{ m.id }}"/></svg>
    {% endfor %}
</div>

<div class="schematic-bg schematic-bg--right" aria-hidden="true">
    {% for m in sbgRightMotifs %}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ m.h }}" style="--sbg-y: {{ m.y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false"><use href="#sbg-{{ m.id }}"/></svg>
    {% endfor %}
</div>
