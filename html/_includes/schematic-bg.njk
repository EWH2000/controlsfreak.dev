<line x1="4"   y1="56" x2="196" y2="56" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<path d="M88 20 L88 36 L100 28 Z M112 20 L112 36 L100 28 Z" stroke="var(--blue)" fill="none" data-sbg-stroke/>
