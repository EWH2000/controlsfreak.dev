{# ─────────────────────────────────────────────────────────────────
    SCHEMATIC BACKGROUND — gutter as-builts.

    Two narrow vertical strips, one in each gutter, holding inline-
    SVG motifs (piping, control wiring, function blocks, BACnet
    nodes). Strips sit at z-index:-1 inside body's stacking context
    (above the blueprint grid, below every content surface).

    Each motif is inlined directly into its <svg class="sbg-motif">
    wrapper — no <symbol>/<use>. flow-engine.js reads path geometry
    via getTotalLength() / getPointAtLength(), and that doesn't pierce
    <use> shadow trees in Chromium (same root cause that bit us with
    `fill:none` on the first pass). The trade-off is repeated markup
    across motifs — kept manageable by the {% macro motifBody %}
    below, which expands by id.

    Path tagging conventions:
        data-flow="supply"|"return"   continuous particle flow
                                      (hydronic pipes; flow-engine.js
                                      handles the rest)
        data-pulse="signal"           EBO-style discrete pulse on the
                                      wire (analog/binary control
                                      wiring, function-block signal
                                      lines, BACnet/IP comm traces)
        data-pulse-color="<var()>"    pulse fill; default = the path's
                                      stroke attr
        data-pulse-interval="<ms>"    auto-fire cadence (default 4000)
        data-sbg-stroke               carries the scroll-reveal
                                      stroke-dashoffset transition
                                      (CSS rule in styles.css uses a
                                      fixed dasharray well above any
                                      path length — see the block
                                      comment there for why all
                                      length-normalization approaches
                                      hit Chromium quirks).

    Hidden below 1240px viewport (no real gutter to fill) and on
    print. Decorative only: aria-hidden, pointer-events:none.
#}

{% macro motifBody(id) -%}
{%- if id == 'pipe-valve' -%}
{# 3-way diverting valve serving a coil with a bypass loop back to return.
   Supply main runs L→R across the top; return main runs R→L across the
   bottom (reversed x1/x2 makes flow-engine walk return particles
   right-to-left, so the two mains read as opposing conveyors).
   Bypass-to-tee and coil-to-tee are split at the tee at (120,92) per the
   "converging-flow segments need two paths" rule — bypass arrives R→L
   still tagged supply (hasn't been through the coil), coil-out arrives
   L→R tagged return. Mirrors the convention on education/load-piping.html. #}
<line x1="4"   y1="18"  x2="196" y2="18"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="80"  y1="18"  x2="80"  y2="26"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<path d="M72 26 L88 26 L80 32 Z  M72 38 L88 38 L80 32 Z  M92 26 L92 38 L80 32 Z" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<line x1="80"  y1="38"  x2="80"  y2="42"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<rect x="60"   y="42"   width="40" height="24" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<path d="M66 48 L94 48 M66 54 L94 54 M66 60 L94 60" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<line x1="80"  y1="66"  x2="80"  y2="92"  stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="80"  y1="92"  x2="120" y2="92"  stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="92"  y1="32"  x2="170" y2="32"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="170" y1="32"  x2="170" y2="92"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="170" y1="92"  x2="120" y2="92"  stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="120" y1="92"  x2="120" y2="108" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<line x1="196" y1="108" x2="4"   y2="108" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<text x="14" y="14"  class="sbg-label">SUP</text>
<text x="14" y="124" class="sbg-label">RET</text>
{%- elif id == 'fcu' -%}
{# Fan-coil unit: chilled or heated water circulates through a finned
   coil while a fan moves room air across the fins. Supply and return
   hydronic tubes connect to the cabinet from the gutter edge with
   the opposing-flow trick (supply L→R into the coil, return R→L back
   out) — same convention as pipe-valve. Air-side animation is
   intentionally omitted; the fan icon implies it without adding a
   third particle stream competing for the viewer's attention. The
   cabinet outline groups fan + coil as a single packaged unit, which
   is what "FCU" means to a controls engineer. #}
<rect x="70"  y="15" width="120" height="60" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<rect x="80"  y="25" width="40"  height="40" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<path d="M86 32 L114 32 M86 40 L114 40 M86 48 L114 48 M86 56 L114 56" stroke="var(--blue)" fill="none" data-sbg-stroke/>
<circle cx="155" cy="45" r="13" stroke="var(--blue)" fill="var(--surface)" data-sbg-stroke/>
<text x="155" y="49" text-anchor="middle" class="sbg-label">F</text>
<line x1="4"  y1="30" x2="70" y2="30" stroke="var(--blue)"      data-flow="supply" data-sbg-stroke/>
<line x1="70" y1="60" x2="4"  y2="60" stroke="var(--blue-cool)" data-flow="return" data-sbg-stroke/>
<text x="14"  y="14" class="sbg-label">SUP</text>
<text x="14"  y="78" class="sbg-label">RET</text>
<text x="130" y="88" text-anchor="middle" class="sbg-label">FCU</text>
{%- elif id == 'compare-bo' -%}
{# Small piece of real BAS logic: two analog inputs feed a greater-than
   comparator whose binary result drives a BO. Pattern shows up everywhere
   (high-limit cutoff, OAT-vs-setpoint enable, freezestat). AI1 sits in
   the same row as the comparator and BO1 with a single straight wire
   running the whole way across (the "primary signal path"); AI2 sits
   below and its wire makes one 90° turn to enter the comparator from
   underneath — reads as "AI2 is the variable being tested against the
   AI1 threshold." Amber for analog wires, gray for the binary BO leg,
   plum for the logic block. Staggered pulse intervals so the three
   wires don't fire in lockstep. #}
<rect x="10" y="20" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="31" r="2.5" fill="var(--amber)"/>
<circle cx="38" cy="31" r="2.5" fill="var(--amber)"/>
<text x="29" y="16" text-anchor="middle" class="sbg-label">AI1</text>
<rect x="86" y="20" width="28" height="22" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="35" text-anchor="middle" class="sbg-label">&gt;</text>
<rect x="152" y="20" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="162" cy="31" r="2.5" fill="var(--text-dim)"/>
<circle cx="180" cy="31" r="2.5" fill="var(--text-dim)"/>
<text x="171" y="16" text-anchor="middle" class="sbg-label">BO1</text>
<rect x="10" y="64" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="75" r="2.5" fill="var(--amber)"/>
<circle cx="38" cy="75" r="2.5" fill="var(--amber)"/>
<text x="29" y="96" text-anchor="middle" class="sbg-label">AI2</text>
<line x1="48"  y1="31" x2="86"  y2="31" stroke="var(--amber)"    data-pulse="signal" data-sbg-stroke/>
<line x1="114" y1="31" x2="152" y2="31" stroke="var(--text-dim)" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
<path d="M48 75 L100 75 L100 42" stroke="var(--amber)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
{%- elif id == 'and-bo' -%}
{# Sibling of compare-bo: two binary inputs through an AND gate to a BO.
   Pattern shows up everywhere in BAS — "all proofs made AND schedule
   occupied" before energizing a starter, two safety interlocks both
   need to be true, etc. Layout mirrors compare-bo exactly (same block
   geometry, wire routing, pulse staggering) so the two motifs read as
   a family; only difference is everything is gray (binary) and the
   logic block carries "AND" instead of ">". #}
<rect x="10" y="20" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="31" r="2.5" fill="var(--text-dim)"/>
<circle cx="38" cy="31" r="2.5" fill="var(--text-dim)"/>
<text x="29" y="16" text-anchor="middle" class="sbg-label">BI1</text>
<rect x="86" y="20" width="28" height="22" stroke="var(--plum)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="35" text-anchor="middle" class="sbg-label">AND</text>
<rect x="152" y="20" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="162" cy="31" r="2.5" fill="var(--text-dim)"/>
<circle cx="180" cy="31" r="2.5" fill="var(--text-dim)"/>
<text x="171" y="16" text-anchor="middle" class="sbg-label">BO1</text>
<rect x="10" y="64" width="38" height="22" stroke="var(--text-dim)" fill="var(--surface)" data-sbg-stroke/>
<circle cx="20" cy="75" r="2.5" fill="var(--text-dim)"/>
<circle cx="38" cy="75" r="2.5" fill="var(--text-dim)"/>
<text x="29" y="96" text-anchor="middle" class="sbg-label">BI2</text>
<line x1="48"  y1="31" x2="86"  y2="31" stroke="var(--text-dim)" data-pulse="signal" data-sbg-stroke/>
<line x1="114" y1="31" x2="152" y2="31" stroke="var(--text-dim)" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
<path d="M48 75 L100 75 L100 42" stroke="var(--text-dim)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
{%- elif id == 'current-loop' -%}
{# 2-wire 4-20mA current loop: PSU drives current through a loop-powered
   transmitter (TX) and back through a controller's analog input (AI),
   all in series. Conventional current flows clockwise — out of PSU(+)
   at top-right, L→R across the top through TX and into AI, down out of
   AI(−), L←R along the return wire under the devices, and up into
   PSU(−). Same continuous-particle treatment as hydronic supply/return:
   current is always present when the loop is energized, just modulating
   in magnitude (4mA at 0%, 20mA at 100%). New data-flow="current" value
   in flow-engine.js paints particles amber to match the analog-signal
   color family. #}
<rect x="14"  y="40" width="30" height="20" stroke="var(--amber)" fill="var(--surface)" data-sbg-stroke/>
<text x="29"  y="35" text-anchor="middle" class="sbg-label">PSU</text>
<rect x="85"  y="40" width="30" height="20" stroke="var(--amber)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="35" text-anchor="middle" class="sbg-label">TX</text>
<rect x="156" y="40" width="30" height="20" stroke="var(--amber)" fill="var(--surface)" data-sbg-stroke/>
<text x="171" y="35" text-anchor="middle" class="sbg-label">AI</text>
<line x1="44"  y1="45" x2="85"  y2="45" stroke="var(--amber)" data-flow="current" data-sbg-stroke/>
<line x1="115" y1="45" x2="156" y2="45" stroke="var(--amber)" data-flow="current" data-sbg-stroke/>
<path d="M156 55 L156 75 L44 75 L44 55" stroke="var(--amber)" fill="none" data-flow="current" data-sbg-stroke/>
{%- elif id == 'supervisor' -%}
{# Niagara-style supervisor architecture: JACE on top talks to AHU,
   VAV, and boiler controllers in a star topology — three independent
   wires fanning out from JACE's bottom edge to each controller's top
   edge. Pulses walk upward (controllers reporting field data up to
   the supervisor — Niagara's primary data direction). Staggered
   intervals so the three reports don't fire in lockstep. Teal stays
   the BACnet/comm color across the whole motif. #}
<rect x="70"  y="10" width="60" height="20" stroke="var(--teal)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="23" text-anchor="middle" class="sbg-label">JACE</text>
<rect x="22"  y="62" width="36" height="20" stroke="var(--teal)" fill="var(--surface)" data-sbg-stroke/>
<text x="40"  y="75" text-anchor="middle" class="sbg-label">AHU</text>
<rect x="82"  y="62" width="36" height="20" stroke="var(--teal)" fill="var(--surface)" data-sbg-stroke/>
<text x="100" y="75" text-anchor="middle" class="sbg-label">VAV</text>
<rect x="142" y="62" width="36" height="20" stroke="var(--teal)" fill="var(--surface)" data-sbg-stroke/>
<text x="160" y="75" text-anchor="middle" class="sbg-label">BLR</text>
<path d="M40 62 L80 30"   stroke="var(--teal)" fill="none" data-pulse="signal" data-sbg-stroke/>
<path d="M100 62 L100 30" stroke="var(--teal)" fill="none" data-pulse="signal" data-pulse-interval="5500" data-sbg-stroke/>
<path d="M160 62 L120 30" stroke="var(--teal)" fill="none" data-pulse="signal" data-pulse-interval="4500" data-sbg-stroke/>
{%- endif -%}
{%- endmacro %}

{#  Motifs are placed at uniform Y stride down each gutter, cycling
    through a short sequence so a long page never runs out of motifs.
    Stride = 270px so the tallest motif (pipe-valve at 130px
    rendered ~1.7× = ~221px at the strip's 340px cap) fits with
    breathing room above and below. Count = 60 covers ~16200px of
    page; pages shorter than that just clip the tail via
    overflow:hidden on the strip container.

    Two sequences are offset between left/right so a wide viewport
    doesn't show a mirrored pair. Heights table is shared because
    the macro renders motifs at their viewBox aspect — only the
    h value here matters (sets the SVG's viewBox height). #}

{% set sbgHeights = {
    'pipe-valve': 130,
    'fcu':         95,
    'compare-bo': 102,
    'and-bo':     102,
    'current-loop': 90,
    'supervisor':   90
} %}
{% set sbgLeftCycle = [
    'pipe-valve', 'compare-bo', 'fcu', 'current-loop', 'supervisor',
    'pipe-valve', 'and-bo',     'fcu', 'current-loop', 'supervisor'
] %}
{% set sbgRightCycle = [
    'and-bo',     'current-loop', 'pipe-valve', 'supervisor', 'fcu',
    'compare-bo', 'pipe-valve',   'current-loop', 'supervisor', 'fcu'
] %}
{% set sbgCount  = 60 %}
{% set sbgStride = 270 %}

<div class="schematic-bg schematic-bg--left" aria-hidden="true">
    {%- for i in range(sbgCount) -%}
        {%- set mid = sbgLeftCycle[i % sbgLeftCycle.length] -%}
        {%- set y = 100 + i * sbgStride -%}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ sbgHeights[mid] }}" style="--sbg-y: {{ y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false">{{ motifBody(mid) | safe }}</svg>
    {% endfor %}
</div>

<div class="schematic-bg schematic-bg--right" aria-hidden="true">
    {%- for i in range(sbgCount) -%}
        {%- set mid = sbgRightCycle[i % sbgRightCycle.length] -%}
        {%- set y = 220 + i * sbgStride -%}
    <svg class="sbg-motif" data-sbg-motif viewBox="0 0 200 {{ sbgHeights[mid] }}" style="--sbg-y: {{ y }}px;" preserveAspectRatio="xMidYMin meet" focusable="false">{{ motifBody(mid) | safe }}</svg>
    {% endfor %}
</div>
