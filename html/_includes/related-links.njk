{# Related links — internal cross-linking at the bottom of deep pages
   (tools, simulators, education, practice). Builds topic clusters so
   link equity flows horizontally between related pages instead of
   pooling at the section landings. Pure SEO + UX, no behavior.

   Accepts an `opts` object with up to four optional arrays of
   {href, label} pairs, plus an optional `hub` — either a single
   {href, label} or an array of them (a page that belongs to two
   clusters, e.g. affinity-laws under hydronics AND forced air):

       {% from "related-links.njk" import relatedLinks with context %}
       {{ relatedLinks({
           hub:        {href: '/bacnet/', label: 'The BACnet reference hub'},
           tools:      [{href: '/tools/foo.html',      label: 'Foo'}],
           simulators: [{href: '/simulators/bar.html', label: 'Bar'}],
           lessons:    [{href: '/education/baz.html',  label: 'Baz'}],
           quizzes:    [{href: '/practice/qux.html',   label: 'Qux'}]
       }) }}

   Rendering rules:
   - Each non-empty group becomes a labelled column.
   - `hub` renders first as a "Part of" column — the spoke-to-pillar
     link(s) for a topic cluster (e.g. every BACnet page points back at
     /bacnet/). A single object lists one pillar; an array lists several
     (multi-cluster membership). Normalized to a list below.
   - The whole block renders nothing if every group is empty.
   - Only anchor pages that actually exist today (per the CLAUDE.md
     "Forward-link convention") — don't add href entries to pages that
     are still future work.

   Placement: inside <main>, directly above the `.back-link`. Styling
   in html/styles.css under "RELATED LINKS". #}

{% macro relatedLinks(opts) %}
    {# Normalize `hub` to a list: a single {href,label} has a .href, an
       array does not — so wrap the object, pass the array through. #}
    {% set hubList = [opts.hub] if (opts.hub and opts.hub.href) else (opts.hub or []) %}
    {% set hasHub = hubList.length %}
    {% set hasTools = opts.tools and opts.tools.length %}
    {% set hasSims = opts.simulators and opts.simulators.length %}
    {% set hasLessons = opts.lessons and opts.lessons.length %}
    {% set hasQuizzes = opts.quizzes and opts.quizzes.length %}
    {% if hasHub or hasTools or hasSims or hasLessons or hasQuizzes %}
    <aside class="related-links" aria-label="{{ "related.landmark" | t(locale) }}">
        {% if hasHub %}
        <div class="related-group related-group-hub">
            <h2 class="related-label">{{ "related.partOf" | t(locale) }}</h2>
            <ul>
                {% for h in hubList %}<li><a href="{{ h.href | localePath(locale) }}" rel="related">{{ h.label }}</a></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
        {% if hasTools %}
        <div class="related-group">
            <h2 class="related-label">{{ "related.tools" | t(locale) }}</h2>
            <ul>
                {% for t in opts.tools %}<li><a href="{{ t.href | localePath(locale) }}" rel="related">{{ t.label }}</a></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
        {% if hasSims %}
        <div class="related-group">
            <h2 class="related-label">{{ "related.simulators" | t(locale) }}</h2>
            <ul>
                {% for s in opts.simulators %}<li><a href="{{ s.href | localePath(locale) }}" rel="related">{{ s.label }}</a></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
        {% if hasLessons %}
        <div class="related-group">
            <h2 class="related-label">{{ "related.lessons" | t(locale) }}</h2>
            <ul>
                {% for l in opts.lessons %}<li><a href="{{ l.href | localePath(locale) }}" rel="related">{{ l.label }}</a></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
        {% if hasQuizzes %}
        <div class="related-group">
            <h2 class="related-label">{{ "related.quizzes" | t(locale) }}</h2>
            <ul>
                {% for q in opts.quizzes %}<li><a href="{{ q.href | localePath(locale) }}" rel="related">{{ q.label }}</a></li>{% endfor %}
            </ul>
        </div>
        {% endif %}
    </aside>
    {% endif %}
{% endmacro %}
