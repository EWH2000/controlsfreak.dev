# KDE Dolphin folder settings
.directory

# Common OS junk
.DS_Store
Thumbs.db

# Editor backup/swap files
*~
*.swp
*.swo
.vscode/
.idea/

# Claude Code — per-developer local settings + runtime artifacts
# (settings.local.json, scheduled_tasks.lock, worktrees/) stay out of
# history. Shared skills under .claude/skills/ ARE committed: they encode
# repo conventions the same way CLAUDE.md does, so they belong in the tree.
# Note the `.claude/*` + negation shape — a bare `.claude/` excludes the
# directory itself and git never descends into it, so `!.claude/skills/`
# alone would not re-include anything. A shared .claude/settings.json would
# need its own un-ignore line here.
.claude/*
!.claude/skills/

# Node / npm
node_modules/
npm-debug.log*

# Local secrets — wrangler dev --local convention (.dev.vars) and any
# .env that creeps in. Worker secrets live in `wrangler secret put`.
.env
.env.*
.dev.vars

# Wrangler local state — dev/deploy/tail write caches, deploy state, and
# tmp bundles here (.wrangler/tmp already appears after any wrangler run).
# None of it belongs in history; no secrets (those are covered above).
.wrangler/

# Playwright
test-results/
playwright-report/
.playwright/

# 11ty build output
_site/

# SEO data exports (Google Search Console / Bing performance dumps dropped
# in for analysis — working data, not site source). Kept out of history.
controlsfreak.dev-Performance-on-Search-*.zip
controlsfreak.dev_SearchPerformanceOverview_*.csv
