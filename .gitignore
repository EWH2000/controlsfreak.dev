# KDE Dolphin folder settings
.directory

# Common OS junk
.DS_Store
Thumbs.db

# Editor backup/swap files
*~
*.swp
*.swo
.vscode/
.idea/

# Claude Code — per-developer local settings + runtime artifacts
# (settings.local.json, scheduled_tasks.lock). A shared, committed
# .claude/settings.json would need an explicit un-ignore.
.claude/

# Node / npm
node_modules/
npm-debug.log*

# Local secrets — wrangler dev --local convention (.dev.vars) and any
# .env that creeps in. Worker secrets live in `wrangler secret put`.
.env
.env.*
.dev.vars

# Playwright
test-results/
playwright-report/
.playwright/

# 11ty build output
_site/
