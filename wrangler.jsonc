{
  "name": "controlsfreak",
  // Worker entry point — handles POST /api/contact, everything else falls
  // through to the static assets below via env.ASSETS.
  "main": "src/worker.js",
  "compatibility_date": "2026-05-17",
  "assets": {
    // Built by 11ty from html/ (see .eleventy.js). Cloudflare Workers
    // Build dashboard runs `npm install && npm run build` to produce
    // _site/ in CI; deploys serve from there. Source files in html/
    // (including _includes/ and html.11tydata.js) stay out of the
    // public URL space because 11ty skips _-prefixed paths.
    "directory": "./_site",
    // Lets the Worker reference env.ASSETS to serve static files.
    "binding": "ASSETS",
    // Clean URLs: /contact serves contact.html.
    "html_handling": "auto-trailing-slash",
    // Serve _site/404.html with a 404 status for any URL that doesn't
    // match an asset (instead of CF's generic default). html/404.html
    // is the source; it carries `noindex` + `eleventyExcludeFromCollections`
    // so it stays out of the sitemap.
    "not_found_handling": "404-page"
  }
}
